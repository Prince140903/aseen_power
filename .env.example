# ===============================================
# Supabase Configuration (Required)
# ===============================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===============================================
# EmailJS Configuration (Required for Form Submissions)
# ===============================================
# 1. Sign up at https://www.emailjs.com
# 2. Get your Public Key from EmailJS Dashboard
# 3. Create email templates for quote and contact forms
# 4. Get your Service ID and Template IDs

NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_QUOTE_TEMPLATE_ID=your_quote_template_id
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
NEXT_PUBLIC_EMAILJS_ADMIN_EMAIL=contact@aseenpower.com

# ===============================================
# Document Access Configuration
# ===============================================
# The default password for document access
# This should be overridden via the CMS Settings panel
# Do NOT commit actual passwords to version control
DOCUMENT_ACCESS_PASSWORD_DEFAULT=aseenpower2026

# ===============================================
# Admin Configuration
# ===============================================
# NEVER commit the actual admin password to git
# Use environment variable in production
# Change this immediately after setup
ADMIN_PASSWORD=admin@aseen2026
